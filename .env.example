# Harmonix Backend Configuration
# Copy to .env and fill in values

# Server
PORT=3001
ROLE=source

# Database
DB_PATH=./data/harmonix.db

# Music directory (scanned by admin scan job)
MUSIC_DIR=./music

# Cover art directory
COVERS_DIR=./data/covers/

# JWT Secret (REQUIRED - must be set, no default allowed for security)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-secret-min-32-chars

# Frontend URL (for CORS in production)
# FRONTEND_URL=http://localhost:5173