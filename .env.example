# Harmonix Backend Configuration
# Copy to .env and fill in values

# Server
PORT=3001

# Server role: "source" (library + API) or "player" (playback only)
ROLE=source

# URL of source server (required for player-role servers)
# SOURCE_URL=http://localhost:3001

# Database
DB_PATH=./data/harmonix.db

# Music directory (scanned by admin scan job)
MUSIC_DIR=./music

# Cover art directory
COVERS_DIR=./data/covers/

# JWT Secret (REQUIRED - must be set, min 32 chars, cannot be a known default)
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Path to ffplay binary (default: ffplay)
# FFPLAY_PATH=ffplay

# Frontend URL (for CORS in production)
# FRONTEND_URL=http://localhost:5173
